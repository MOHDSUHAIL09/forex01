[Unit]
Description=ForexBot Automated Multi-User Trading Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/ForexBot
Environment="PATH=/var/www/ForexBot/venv/bin"
Environment="PORT=5000"
Environment="HOST=0.0.0.0"
ExecStart=/var/www/ForexBot/venv/bin/python server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
